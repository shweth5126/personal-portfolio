---
import { services } from "../data/content.js";
---
<section class="py-12 md:py-20 bg-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12 md:mb-16 reveal">
      <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold mb-4 cinzel">{services.heading}</h2>
      <p class="text-lg text-gray-600">{services.note}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 reveal">
      {
        services.groups.map((g) => (
          <div class="border-2 border-black rounded-2xl p-6 md:p-8 bg-white">
            <h3 class="text-xl md:text-2xl font-bold mb-5">{g.name}</h3>
            <ul class="grid gap-3">
              {g.items.map((i) => (
                <li class="flex items-start gap-3 text-gray-700">
                  <span class="mt-2 w-2 h-2 rounded-full bg-black flex-shrink-0" />
                  {i}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="flex flex-wrap items-center justify-center gap-3 mt-10 reveal">
      <span class="text-xs uppercase tracking-widest text-gray-500">Tools</span>
      {services.tools.map((t) => (
        <span class="border border-gray-300 rounded-full px-4 py-1.5 text-sm">{t}</span>
      ))}
    </div>

    <div class="text-center mt-10 reveal">
      <a
        href={services.ctaHref}
        class="inline-block bg-black text-white px-8 py-3 rounded-full font-semibold hover:bg-gray-800 transition-colors"
      >
        {services.ctaText}
      </a>
    </div>
  </div>
</section>
