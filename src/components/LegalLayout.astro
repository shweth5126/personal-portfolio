---
import Base from "../layouts/Base.astro";
import { site } from "../data/content.js";
const { title, updated } = Astro.props;
---
<Base title={title}>
  <main class="max-w-3xl mx-auto px-6 py-16 md:py-24">
    <a href="/" class="text-sm text-gray-500 hover:text-black">&larr; Back to home</a>
    <h1 class="cinzel text-3xl md:text-4xl mt-4 mb-2">{title}</h1>
    <p class="text-sm text-gray-500 mb-10">Last updated: {updated}</p>
    <div class="prose-legal space-y-5 text-gray-700 leading-relaxed">
      <slot />
    </div>
  </main>
</Base>

<style is:global>
  .prose-legal h2 {
    font-weight: 600;
    font-size: 1.15rem;
    margin-top: 2rem;
    color: #111;
  }
  .prose-legal a { text-decoration: underline; }
</style>
