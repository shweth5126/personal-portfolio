---
import Icon from "./Icon.astro";
import { process } from "../data/content.js";
---
<section class="mb-16">
  <div class="pt-8">
    <section class="py-12 md:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 md:mb-16 reveal">
          <div class="flex items-center justify-center mb-6">
            <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold cinzel px-4">
              {process.heading}
            </h2>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 lg:gap-8 max-w-6xl mx-auto overflow-visible">
          {
            process.steps.map((s) => (
              <div
                class="bg-white rounded-xl md:rounded-2xl lg:rounded-3xl p-4 md:p-6 lg:p-8 text-gray-800 relative overflow-visible shadow-xl hover:shadow-2xl transition-all duration-300 border-2 border-black reveal"
                style="min-height: 350px;"
              >
                <div class="flex items-center mb-4 md:mb-6 lg:mb-8 relative z-10">
                  <div class="w-10 h-10 md:w-12 md:h-12 lg:w-16 lg:h-16 bg-black rounded-lg md:rounded-xl lg:rounded-2xl flex items-center justify-center mr-3 md:mr-4 lg:mr-6 shadow-lg">
                    <span class="text-base md:text-lg lg:text-2xl font-bold text-white">{s.num}</span>
                  </div>
                  <div class="w-8 h-8 md:w-10 md:h-10 lg:w-12 lg:h-12 bg-gray-100 rounded-md md:rounded-lg lg:rounded-xl flex items-center justify-center shadow-md">
                    <Icon name={s.icon} class="w-4 h-4 md:w-5 md:h-5 lg:w-6 lg:h-6 text-gray-800" />
                  </div>
                </div>
                <h3 class="text-lg md:text-xl lg:text-2xl font-bold mb-3 md:mb-4 lg:mb-6 text-gray-800 relative z-10">
                  {s.title}
                </h3>
                <p class="text-gray-600 text-xs md:text-sm lg:text-base leading-relaxed mb-4 md:mb-6 lg:mb-8 relative z-10">
                  {s.body}
                </p>
                <div class="absolute bottom-0 right-0">
                  <img src={s.avatar} alt="" class="w-16 h-16 md:w-20 md:h-20 lg:w-28 lg:h-28 object-cover" />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</section>
